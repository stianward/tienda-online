# ===================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - GRABAMIL
# ===================================================

# Firebase Client SDK (Consola de Firebase -> Configuración del proyecto)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKey12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=grabamil-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=grabamil-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=grabamil-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Firebase Admin SDK (Para Server Actions y API Routes seguras en GCP)
# String JSON de la cuenta de servicio de Firebase / GCP
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"grabamil-app","private_key_id":"...","private_key":"...","client_email":"..."}'

# Pasarela de Pagos Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-...
MERCADOPAGO_CLIENT_ID=your_client_id
MERCADOPAGO_CLIENT_SECRET=your_client_secret
NEXT_PUBLIC_MERCADOPAGO_ENV=production
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_here

# Configuración de Servidor
NEXT_PUBLIC_APP_URL=http://localhost:3000
